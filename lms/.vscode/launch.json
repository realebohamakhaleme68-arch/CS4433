{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LMS (gdb / MinGW / Linux / macOS-lldb: pick the right one)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "Run LMS (Visual Studio compiler, Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/lms_tests",
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb"
    }
  ]
}
